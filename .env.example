# ===== Server =====
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string

# ===== MySQL Database =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=studyself_ai

# ===== AI Service =====
# StudySelf AI works with any OpenAI-compatible chat completion API.
# If AI_API_KEY is left empty, the app automatically runs in DEMO MODE:
# it returns clearly-labeled sample AI content so every feature can be
# tested end-to-end without a live key.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== Uploads =====
MAX_UPLOAD_MB=10
