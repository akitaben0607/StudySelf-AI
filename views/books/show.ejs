<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="app-body">
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <main class="app-main">
    <%- include('../partials/flash') %>

    <div class="breadcrumb"><a href="/dashboard">Books</a> / <span><%= book.title %></span></div>

    <div class="page-head">
      <div>
        <h1><%= book.title %></h1>
        <p class="page-sub">Created <%= book.created_year %><% if (book.description) { %> · <%= book.description %><% } %></p>
      </div>
      <div class="page-head-actions">
        <a href="/books/<%= book.id %>/edit" class="btn btn-outline">Edit</a>
      </div>
    </div>

    <div class="tool-row">
      <a href="/books/<%= book.id %>/quiz" class="tool-card tool-card-primary">
        <span class="tool-icon">◎</span>
        <div><strong>Take Quiz</strong><p>Test yourself on this Book</p></div>
      </a>
      <a href="/books/<%= book.id %>/flashcards" class="tool-card">
        <span class="tool-icon">▭</span>
        <div><strong>Flashcards</strong><p>Flip through key concepts</p></div>
      </a>
      <a href="/books/<%= book.id %>/studymap" class="tool-card">
        <span class="tool-icon">◈</span>
        <div><strong>Study Map</strong><p>See how topics connect</p></div>
      </a>
    </div>

    <div class="section-head">
      <h2>Topics</h2>
      <button class="btn btn-primary" data-open-modal="new-topic-modal">+ New Topic</button>
    </div>

    <% if (topics.length === 0) { %>
      <div class="empty-state">
        <h3>No topics yet.</h3>
        <p>Add your first Topic to start chatting, quizzing, and revising.</p>
        <button class="btn btn-primary" data-open-modal="new-topic-modal">+ New Topic</button>
      </div>
    <% } else { %>
      <div class="topic-list">
        <% topics.forEach(function(t) { %>
          <div class="topic-row">
            <a href="/topics/<%= t.id %>" class="topic-row-title">
              <span class="topic-dot"></span><%= t.title %>
            </a>
            <div class="topic-row-actions">
              <button class="icon-btn" data-open-modal="rename-modal-<%= t.id %>" title="Rename">✎</button>
              <form action="/topics/<%= t.id %>/delete" method="POST" class="confirm-delete" data-confirm="Delete topic &quot;<%= t.title %>&quot;? This removes its chat history too.">
                <button type="submit" class="icon-btn icon-btn-danger" title="Delete">✕</button>
              </form>
            </div>
          </div>

          <div class="modal" id="rename-modal-<%= t.id %>">
            <div class="modal-card">
              <h3>Rename Topic</h3>
              <form action="/topics/<%= t.id %>/rename" method="POST">
                <input type="text" name="title" value="<%= t.title %>" required autofocus />
                <div class="form-actions">
                  <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
                  <button type="submit" class="btn btn-primary">Save</button>
                </div>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="modal" id="new-topic-modal">
      <div class="modal-card">
        <h3>New Topic</h3>
        <form action="/books/<%= book.id %>/topics" method="POST">
          <input type="text" name="title" placeholder="e.g. Neural Networks" required autofocus />
          <div class="form-actions">
            <button type="button" class="btn btn-outline" data-close-modal>Cancel</button>
            <button type="submit" class="btn btn-primary">Add Topic</button>
          </div>
        </form>
      </div>
    </div>
  </main>
</div>
<script src="/js/app.js"></script>
</body>
</html>
